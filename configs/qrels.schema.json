{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.vifinqa.dev/schema/qrels-v2.json",
  "title": "ViFinQA internal qrel annotation v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "question",
    "stratum",
    "split_group",
    "answerability",
    "answerability_reason",
    "gold_docs",
    "gold_tables",
    "gold_cells",
    "intermediate_facts",
    "cohort_members",
    "operator_family",
    "formula_id",
    "source_units",
    "target_unit",
    "program",
    "answer",
    "tolerance",
    "rounding",
    "status",
    "judgments",
    "adjudication_notes",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 1},
    "stratum": {"type": "string", "minLength": 1},
    "split_group": {
      "type": "object",
      "required": ["entities", "years", "question_fingerprint"],
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "years": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "question_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "answerability": {
      "enum": [
        "UNKNOWN",
        "ANSWERABLE",
        "MISSING_IN_CORPUS",
        "RETRIEVAL_INCOMPLETE",
        "PARSE_OR_UNIT_AMBIGUOUS",
        "CONFLICTING_EVIDENCE",
        "EXECUTION_OR_MODEL_FAILURE"
      ]
    },
    "answerability_reason": {"type": "string"},
    "gold_docs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gold_tables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gold_cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_ref", "row_index", "column_index", "role", "raw_label"],
        "properties": {
          "table_ref": {"type": "string", "minLength": 1},
          "row_index": {"type": "integer", "minimum": 0},
          "column_index": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1},
          "raw_label": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "intermediate_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "role", "evidence_cells", "expression", "value", "unit"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "evidence_cells": {"type": "array", "items": {"type": "string"}},
          "expression": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "cohort_members": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "operator_family": {"type": "string", "minLength": 1},
    "formula_id": {"type": ["string", "null"]},
    "source_units": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target_unit": {"type": "string", "minLength": 1},
    "program": {"type": ["object", "string", "null"]},
    "answer": {"type": ["number", "null"]},
    "tolerance": {"type": ["number", "null"], "minimum": 0},
    "rounding": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"enum": ["none", "decimal_places", "significant_digits"]},
        "digits": {"type": "integer", "minimum": 0}
      },
      "required": ["mode", "digits"],
      "additionalProperties": false
    },
    "status": {"enum": ["unlabeled", "annotated", "reviewed", "adjudicated"]},
    "judgments": {
      "type": "object",
      "required": ["annotator_a", "annotator_b", "adjudicator"],
      "properties": {
        "annotator_a": {"type": ["string", "null"]},
        "annotator_b": {"type": ["string", "null"]},
        "adjudicator": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "adjudication_notes": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
