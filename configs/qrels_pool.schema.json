{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.vifinqa.dev/schema/qrels-pool-v1.json",
  "title": "ViFinQA pooled retrieval candidates",
  "type": "object",
  "required": ["schema_version", "id", "question", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_ref", "sources", "relevance", "sufficiency", "notes"],
        "properties": {
          "table_ref": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["run", "ranking", "rank"],
              "properties": {
                "run": {"type": "string", "minLength": 1},
                "ranking": {"type": "string", "minLength": 1},
                "rank": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "relevance": {"enum": ["unjudged", "not_relevant", "partial", "relevant"]},
          "sufficiency": {"enum": ["unknown", "insufficient", "sufficient"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
